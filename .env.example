# Public project catalog (no secrets)
GITHUB_PROJECT_OWNER=ml-laboratory
# Set to org for an organization owner; defaults to user.
GITHUB_PROJECT_OWNER_TYPE=user
GITHUB_PROJECT_TOPIC=ml-laboratory-project

# The catalog revalidates hourly and degrades safely to an empty catalog when
# GitHub or project README requests fail.

# Existing Sanity and email variables belong here locally as needed; never commit their values.
